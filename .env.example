# Backend
DATABASE_URL=/data/netvista.db
HOST=0.0.0.0
PORT=8040
NMAP_PATH=nmap
DATA_DIR=/data
MAX_CONCURRENT_SCANS=2
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (frontend URLs).
CORS_ORIGINS=http://localhost:5175

# Optional API key. Empty = auth disabled (open API). When set, every /api
# endpoint except /api/health requires the X-API-Key header (or api_key query param).
API_KEY=

# Reject scan targets whose range is larger than this many addresses
# (default 65536 = a /16).
MAX_TARGET_ADDRESSES=65536

# Frontend (build-time). Must match the backend API_KEY when auth is enabled.
VITE_API_KEY=
